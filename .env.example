# Server-only configuration. Never use a NEXT_PUBLIC_ prefix for the API key.
AGENT_API_BASE_URL=<agent-base-url>
# Optional; defaults to /ag-ui/agent.
AGENT_API_PATH=/ag-ui/agent
AGENT_API_KEY=replace-with-your-api-key

# Public, build-time frontend configuration. These values are visible in the
# browser bundle; never put credentials in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_APP_NAME=AgentCore
NEXT_PUBLIC_PAGE_TITLE=AgentCore · 让想法继续
NEXT_PUBLIC_PAGE_DESCRIPTION=与 AI 自然对话，让灵感、问题和想法在这里继续。
NEXT_PUBLIC_APP_TAGLINE=让想法继续。
NEXT_PUBLIC_WELCOME_TITLE=有什么我可以帮你的吗？
NEXT_PUBLIC_WELCOME_SUBTITLE=从一个问题开始，让想法更进一步。
NEXT_PUBLIC_COMPOSER_PLACEHOLDER=有问题，尽管问
# light or dark
NEXT_PUBLIC_DEFAULT_THEME=light
# Six-digit hex colors. The rest of each palette lives in src/config/frontend.ts.
NEXT_PUBLIC_LIGHT_ACCENT=#448976
NEXT_PUBLIC_DARK_ACCENT=#87bfae

# Agent <AGENTCORE_ARTIFACT_ROOT>/<namespace>/example.pptx maps below OSS_OBJECT_PREFIX.
# OSS configuration belongs to this application, not the STS function.
FILE_STORAGE_BACKEND=oss
# Must equal agentcore-runloop's deployment-owned publish root. No code default.
AGENTCORE_ARTIFACT_ROOT=/your/oss/artifact-root
FILE_ACCESS_MODE=user
OSS_BUCKET=
OSS_REGION=
OSS_OBJECT_PREFIX=agentcore/files
# Optional: custom OSS endpoint / CNAME (e.g. internal endpoint for ECS).
OSS_ENDPOINT=
OSS_CNAME=
# Client uploads use the shared Chat/Runloop layout below even when the agent
# workspace backend is NAS:
# <OSS_OBJECT_PREFIX>/users/<uid>/<conversationId>/uploads/<uploadId>/<safeFilename>
# OSS bucket CORS must allow PUT from BETTER_AUTH_URL with the Content-Type header.
# The browser receives only a 10-minute single-object signed URL, never STS credentials.
# user: each account reads its own prefix; shared: all signed-in app users may
# read this OSS_OBJECT_PREFIX. Identity method is configured separately below.


# Login / registration. SQLite is created and migrated automatically on startup.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
# Public origin, exactly matching the browser URL; use HTTPS in production.
BETTER_AUTH_URL=http://127.0.0.1:3000
# Mount this directory persistently when deploying; never commit the DB or .env.local.
AUTH_DATABASE_PATH=./data/auth.sqlite
# Aliyun OAuth is temporarily disabled in source, including the login entry.
# Retained for a future restoration; environment variables alone cannot enable it.
# ALIYUN_OAUTH_CLIENT_ID=
# ALIYUN_OAUTH_CLIENT_SECRET=

# STS Broker (optional; required when agent uses FILE_ACCESS_MODE=user with OSS).
# Defaults to AGENT_API_BASE_URL + /v1/sts when unset.
STS_BROKER_URL=
# Gateway x-api-key; falls back to AGENT_API_KEY when unset.
STS_BROKER_API_KEY=
# Application-layer HMAC signing identity (64-char hex secret).
STS_BROKER_KEY_ID=
STS_BROKER_SECRET=

# WAT identity mode, independent of FILE_ACCESS_MODE:
# user_id: default/local, all signed-in users use app:<userId> with ForUserId.
# app_jwt: issue our own JWT for all signed-in users; requires HTTPS discovery
# and JWKS registered with Agent Identity and linked to the workload first.
# login_provider: optional legacy mode, Aliyun ID Token for cloud logins,
# app:<userId> for email logins. Never silently falls back on JWT failure.
AGENT_IDENTITY_AUTH_MODE=user_id
# Set the canonical public HTTPS ORIGIN, no path, e.g. https://chat.example.com.
# Public discovery can be configured before enabling app_jwt.
APP_IDENTITY_ISSUER=
APP_IDENTITY_AUDIENCE=agentcore-chat
# Persistent server-only keyring; generate once with npm run identity:init.
# Default directory is ignored by git and excluded from the build bundle.
APP_IDENTITY_KEY_FILE=./data/identity/keyring.private.json
# 600..3600 seconds; JWTs are also capped by the current login session expiry.
APP_IDENTITY_TOKEN_TTL_SECONDS=900
